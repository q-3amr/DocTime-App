@model Employee
@{ViewData["Title"]="Add employee";}<section class="page-heading"><div><p class="eyebrow">PEOPLE / NEW</p><h1>Add an employee</h1><p class="subtitle">Set up a new team member in a few quick steps.</p></div></section><div class="form-layout"><form asp-action="Create" method="post" class="form-card"><div class="steps"><span class="current">1</span><b>Personal details</b><i></i><span>2</span><b>Role & team</b><i></i><span>3</span><b>Compensation</b><i></i><span>4</span><b>Review</b></div><div class="form-body"><h2>Personal details</h2><p class="section-copy">Start with the basics. You can add more information later.</p><div class="field-grid"><label>Full name<input asp-for="FullName" placeholder="e.g. Alex Morgan" required></label><label>Work email<input asp-for="Email" type="email" placeholder="alex@company.com" required></label><label>Phone number<input asp-for="Phone" type="tel" maxlength="10" placeholder="0791234567" required></label><label>Start date<input asp-for="StartDate" type="date" required></label><label>Job title<input asp-for="Role" placeholder="e.g. Product Designer" required></label><label>Department<select asp-for="Dept"><option value="">Select department</option><option>Engineering</option><option>Product</option><option>Design</option><option>Marketing</option><option>HR</option><option>Finance</option><option>Operations</option></select></label></div></div><div class="form-actions"><a asp-action="Index" class="btn">Cancel</a><button class="btn primary" type="submit">Continue →</button></div></form><aside class="preview"><p class="eyebrow">LIVE PREVIEW</p><div class="preview-card"><div class="preview-avatar">AM</div><h2>New team member</h2><p>Complete the form to preview</p><hr><div class="preview-line"><span>Department</span><strong>Not set</strong></div><div class="preview-line"><span>Start date</span><strong>Not set</strong></div></div><div class="tip"><b>✦ Pro tip</b><p>A clear profile helps teammates know who to reach out to.</p></div></aside></div>
