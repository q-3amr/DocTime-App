@model EmployeeDirectoryViewModel
@{ViewData["Title"]="People";}<section class="page-heading"><div><p class="eyebrow">TEAM DIRECTORY</p><h1>People <span class="count">@Model.Employees.Count</span></h1><p class="subtitle">Your team, all in one place.</p></div><a class="btn primary" asp-action="Create">＋ Add employee</a></section><div class="stats"><div><span class="stat-icon blue">◎</span><div><small>ACTIVE PEOPLE</small><strong>@Model.ActiveCount</strong><span class="trend">↑ 8.3%</span></div></div><div><span class="stat-icon green">◷</span><div><small>ON TIME TODAY</small><strong>92%</strong><span class="trend">↑ 4.1%</span></div></div><div><span class="stat-icon purple">⌁</span><div><small>OPEN POSITIONS</small><strong>4</strong><span class="muted">this quarter</span></div></div><div><span class="stat-icon orange">◌</span><div><small>UPCOMING BIRTHDAYS</small><strong>3</strong><span class="muted">next 30 days</span></div></div></div><div class="toolbar"><form method="get" class="search"><span>⌕</span><input name="search" value="@Model.Search" placeholder="Search people..." /></form><form method="get" class="filter"><select name="department" onchange="this.form.submit()"><option>All departments</option>@foreach(var d in Model.Departments){<option selected="@(d==Model.Department)">@d</option>}</select></form><div class="view-toggle"><button class="selected">▦</button><button>☷</button></div></div><div class="people-grid">@foreach(var e in Model.Employees){<article class="person-card"><div class="card-top"><img src="@e.Avatar" alt="@e.FullName"><span class="status-dot"></span><button>⋯</button></div><h3>@e.FullName</h3><p>@e.Role</p><div class="dept">@e.Dept</div><div class="card-foot"><span><i></i> Active</span><a asp-action="Details" asp-route-id="@e.Id">View profile →</a></div></article>}</div></section>
