@model AttendanceViewModel
@{ViewData["Title"]="Attendance";}<section class="page-heading"><div><p class="eyebrow">DAILY OPERATIONS</p><h1>Attendance</h1><p class="subtitle">Track who's in, remote, or away today.</p></div><form class="date-picker"><button type="button">‹</button><input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" onchange="this.form.submit()"><button type="button">›</button></form></section><div class="attendance-kpis"><div><small>PRESENT</small><strong>@Model.Present</strong><span class="kpi-green">● 76.9% of team</span></div><div><small>LATE</small><strong>@Model.Late</strong><span class="kpi-orange">● Needs attention</span></div><div><small>ABSENT</small><strong>@Model.Absent</strong><span class="kpi-red">● Follow up</span></div><div><small>REMOTE</small><strong>@Model.Remote</strong><span class="kpi-blue">● Working off-site</span></div></div><div class="attendance-table"><div class="table-header"><strong>Daily attendance</strong><span>@Model.Date.ToString("dddd, MMMM d, yyyy")</span><button class="btn">Export report ↓</button></div><table><thead><tr><th>EMPLOYEE</th><th>STATUS</th><th>CHECK IN</th><th>CHECK OUT</th><th>HOURS</th><th>NOTES</th></tr></thead><tbody>@foreach(var e in Model.Employees){var r=Model.RecordFor(e.Id);<tr><td><div class="employee-cell"><img src="@e.Avatar"><span><b>@e.FullName</b><small>@e.Dept</small></span></div></td><td><select class="status-select @r.Status.ToLower()" data-id="@e.Id" data-date="@Model.Date.ToString("o")"><option selected="@(r.Status=="Present")">Present</option><option selected="@(r.Status=="Late")">Late</option><option selected="@(r.Status=="Absent")">Absent</option><option selected="@(r.Status=="Remote")">Remote</option></select></td><td><input class="time-input" value="@r.CheckIn"></td><td><input class="time-input" value="@r.CheckOut"></td><td><span class="hours">@r.HoursWorked h</span></td><td><input class="note-input" placeholder="Add note"></td></tr>}</tbody></table></div></section>
